# Resend API Key para newsletter
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Supabase config
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Clave de acceso al panel /inscripcion/admin (inscripción a salas OAV 2026).
# Uso interno del equipo organizador, no es un login individual.
CATAS_ADMIN_PASSCODE=cambiar-esta-clave

# Token del API externo del CRM de OAV para verificar participantes confirmados
# (crm.odaalvino.com.br/api/external/participants/check). Ver apiparticipantcheck.md.
OAV_PARTICIPANTS_API_TOKEN=pedir-token-al-equipo-de-oav
